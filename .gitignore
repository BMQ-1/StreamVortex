# ==============================================================================
# StreamVortex .gitignore
# Covers Python, PyInstaller binaries, Playwright, media, logs, and OS files
# ==============================================================================

# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging / PyInstaller artifacts
build/
dist/
bin/
*.exe
*.dll
*.dylib
*.bin
*.spec
*.manifest
*.egg-info/
.eggs/
*.egg
*.whl
*.tar.gz

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Playwright & browser caching
.playwright/
test-results/
playwright-report/
.cache/

# User downloaded media (prevent accidental commit of test streams & downloads)
*.mp4
*.mkv
*.flv
*.m3u8
*.ts
*.part
*.ytdl
*.aria2
*.mp3
*.m4a
*.aac
*.wav
*.webm
*.ogg
*.opus
*.jpg
*.jpeg
*.png
*.webp
*.gif

# StreamVortex user runtime config, history & logs
.streamvortex/
*.log
logs/

# IDE / Editor directories & files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Testing, Type Checking & Code Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
