# ==============================================================================
# StreamVortex .gitignore
# Complete coverage for Python, packaging, virtualenvs, media, logs, & OS files
# ==============================================================================

# Python Byte-compiled / optimized / C-extensions
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll

# Distribution / Packaging / PyInstaller Build Artifacts
build/
dist/
bin/
*.exe
*.manifest
*.egg-info/
.eggs/
*.egg
*.whl
*.tar.gz

# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Playwright & Headless Browser Cache
.playwright/
test-results/
playwright-report/
.cache/

# User Downloaded Media & Output Files (Lossless streams, video, audio)
downloads/
recordings/
*.mp4
*.mkv
*.flv
*.avi
*.mov
*.wmv
*.m3u8
*.ts
*.part
*.ytdl
*.aria2
*.mp3
*.m4a
*.aac
*.wav
*.webm
*.ogg
*.opus
*.flac
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.ico

# StreamVortex Local Runtime Config, History & Logs
.streamvortex/
*.log
logs/
*.conf
yt-dlp.conf

# Sensitive Secrets & Environment Variables
.env
.env.*
*.pem
*.key
*.cert

# IDE / Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Temporary Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Testing, Code Quality & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
